# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_ID=123456789
# Optional: Reverse proxy URL for Telegram API (e.g. Cloudflare Worker: https://silent-boat-fd4c.k11298379.workers.dev)
TELEGRAM_API_SERVER=

# WebApp and Server Configuration
PORT=8000
HOST=0.0.0.0
BASE_URL=http://localhost:8000
WEBAPP_URL=http://localhost:8000/app

# Database Configuration (SQLite default, or PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Scheduler Settings (24h format in UTC+5 / Екатеринбург)
NOTIFICATION_TIME_EVENING=19:00
TIMEZONE=Asia/Yekaterinburg

# Google Gemini API Key (для генерации интересных фактов)
GEMINI_API_KEY=your_gemini_api_key_here



# Natbirzha security / creator controls
ALLOW_TEST_AUTH=false
TEST_AUTH_SECRET=replace_with_local_test_secret
CREATOR_TG_IDS=123456789
